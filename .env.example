# Telegram bot
BOT_ENABLED=false
TELEGRAM_TOKEN=
WEBHOOK_URL=https://example.com
WEBHOOK_PATH=/telegram
TELEGRAM_SECRET=replace-with-a-random-secret
DROP_PENDING=false

# Public URL of the web application shown by the bot
WEBAPP_URL=http://localhost:8081

# PostgreSQL used by Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_PORT=5434

# Local port exposed by nginx
APP_PORT=8081

# SQLAlchemy logging
DATABASE_ECHO=false
